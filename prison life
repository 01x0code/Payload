local isMinimized = false
local isDraggingWindow = false
local guiAnimToken = 0
local activeWindowTween = nil

-- Animated Open / Close Helpers
local function setGuiVisibleAnimated(show)
    guiAnimToken += 1
    local token = guiAnimToken

    if activeWindowTween then
        pcall(function() activeWindowTween:Cancel() end)
        activeWindowTween = nil
    end

    if show then
        local showInner = not isMinimized
        TabBar.Visible = showInner
        ClipHost.Visible = showInner
        MainFrame.Visible = true
        MainFrame.Rotation = -4
        MainFrame.Size = isMinimized and MIN_WINDOW_SIZE or UDim2.new(0, 440, 0, 260)

        local targetSz = isMinimized and MIN_WINDOW_SIZE or NORMAL_WINDOW_SIZE
        local tw = playAnim(MainFrame, TweenInfo.new(0.42, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = targetSz,
            Rotation = 0,
        })
        activeWindowTween = tw
        if tw then
            tw.Completed:Connect(function(playbackState)
                if token ~= guiAnimToken then return end
                activeWindowTween = nil
                MainFrame.Rotation = 0
                if playbackState == Enum.PlaybackState.Completed then
                    TabBar.Visible = not isMinimized
                    ClipHost.Visible = not isMinimized
                    if not isMinimized then
                        updateCanvasSize()
                    end
                end
            end)
        else
            MainFrame.Rotation = 0
            if not isMinimized then
                updateCanvasSize()
            end
        end
    else
        if not MainFrame.Visible then return end

        -- Keep TabBar and ClipHost visible during the close tween so MainFrame's ClipsDescendants shrinks them smoothly
        local keepInnerDuringClose = not isMinimized
        TabBar.Visible = keepInnerDuringClose
        ClipHost.Visible = keepInnerDuringClose
        MainFrame.Rotation = 0

        -- When minimized, keep height locked to MIN_WINDOW_SIZE and do not tilt so tabs/content never peek out
        local closeTargetSize = isMinimized and MIN_WINDOW_SIZE or UDim2.new(0, 460, 0, 180)
        local closeTargetRotation = isMinimized and 0 or 3

        local tw = playAnim(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = closeTargetSize,
            Rotation = closeTargetRotation,
        })
        activeWindowTween = tw
        if tw then
            tw.Completed:Connect(function(playbackState)
                if token ~= guiAnimToken then return end
                activeWindowTween = nil
                if playbackState == Enum.PlaybackState.Cancelled then return end
                TabBar.Visible = false
                ClipHost.Visible = false
                MainFrame.Visible = false
                MainFrame.Rotation = 0
                MainFrame.Size = isMinimized and MIN_WINDOW_SIZE or NORMAL_WINDOW_SIZE
            end)
        else
            TabBar.Visible = false
            ClipHost.Visible = false
            MainFrame.Visible = false
            MainFrame.Rotation = 0
            MainFrame.Size = isMinimized and MIN_WINDOW_SIZE or NORMAL_WINDOW_SIZE
        end
    end
end

-- Smooth drag follow while keeping Rotation = 0 for accurate clipping.
do
    local dragInput, dragStart, startPos
    local dragTargetPosition

    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingWindow = true
            dragStart = input.Position
            startPos = MainFrame.Position
            dragTargetPosition = startPos
            MainFrame.Rotation = 0
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isDraggingWindow = false
                end
            end)
        end
    end)

    TitleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    local dragMoveConn = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and isDraggingWindow then
            local delta = input.Position - dragStart
            dragTargetPosition = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    table.insert(activeConnections, dragMoveConn)

    local dragSmoothConn = RunService.RenderStepped:Connect(function(dt)
        if not dragTargetPosition then return end
        local alpha = 1 - math.exp(-24 * dt)
        MainFrame.Position = MainFrame.Position:Lerp(dragTargetPosition, alpha)
        if not isDraggingWindow then
            local dx = MainFrame.Position.X.Offset - dragTargetPosition.X.Offset
            local dy = MainFrame.Position.Y.Offset - dragTargetPosition.Y.Offset
