end

local function getPlayerTeamColor(plr)
    if not Config.UseTeamColorESP or not plr then
        return Config.DefaultBoxColor
    end
    if plr.Team and plr.Team.TeamColor then
        return plr.Team.TeamColor.Color
    end
    if plr.TeamColor then
        return plr.TeamColor.Color
    end
    return Config.DefaultBoxColor
end

