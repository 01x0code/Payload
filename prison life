MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    guiAnimToken += 1
    local token = guiAnimToken

    if activeWindowTween then
        pcall(function() activeWindowTween:Cancel() end)
        activeWindowTween = nil
    end

    -- Keep TabBar and ClipHost visible during the tween so MainFrame's ClipsDescendants shrinks them smoothly
    TabBar.Visible = true
    ClipHost.Visible = true

    local tweenInfo = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    if isMinimized then
        MinimizeBtn.Text = "+"
        local tween = playAnim(MainFrame, tweenInfo, { Size = MIN_WINDOW_SIZE, Rotation = 0 })
        activeWindowTween = tween
        if tween then
            tween.Completed:Connect(function(playbackState)
                if token ~= guiAnimToken then return end
                activeWindowTween = nil
                if playbackState == Enum.PlaybackState.Completed and isMinimized then
                    TabBar.Visible = false
                    ClipHost.Visible = false
                end
            end)
        else
            TabBar.Visible = false
            ClipHost.Visible = false
        end
    else
        MinimizeBtn.Text = "-"
        local tween = playAnim(MainFrame, tweenInfo, { Size = NORMAL_WINDOW_SIZE, Rotation = 0 })
        activeWindowTween = tween
        if tween then
            tween.Completed:Connect(function(playbackState)
                if token ~= guiAnimToken then return end
                activeWindowTween = nil
                if playbackState == Enum.PlaybackState.Completed and not isMinimized then
                    TabBar.Visible = true
                    ClipHost.Visible = true
                    updateCanvasSize()
                end
            end)
        else
            updateCanvasSize()
        end
    end
end)

