-- 1.5 WORKSPACE CONFIG PERSISTENCE (Save / Load in Executor Workspace)
-- ============================================================================
local CONFIG_FOLDER = "PrisonLifeSilentAim"
local CONFIG_FILE = CONFIG_FOLDER .. "/settings_config.json"
local HttpService = game:GetService("HttpService")

local function canUseWorkspaceFS()
    return (typeof(writefile) == "function")
        and (typeof(readfile) == "function")
        and (typeof(isfile) == "function")
end

local function serializeConfig()
    local data = {}
    for k, v in pairs(Config) do
        local t = typeof(v)
        if t == "boolean" or t == "number" or t == "string" then
            data[k] = v
        elseif t == "EnumItem" then
            data[k] = {
                __type = "EnumItem",
                enumType = tostring(v.EnumType),
                name = v.Name,
            }
        elseif t == "Color3" then
            data[k] = {
                __type = "Color3",
                r = math.floor(v.R * 255 + 0.5),
                g = math.floor(v.G * 255 + 0.5),
                b = math.floor(v.B * 255 + 0.5),
            }
        end
    end
    return data
end

local function applyDeserializedConfig(data)
    if type(data) ~= "table" then return end
    for k, raw in pairs(data) do
        if Config[k] ~= nil then
            local expectedType = typeof(Config[k])
            if type(raw) == "table" and raw.__type == "EnumItem" and expectedType == "EnumItem" then
                local okEnum, enumGroup = pcall(function()
                    return Enum[raw.enumType]
                end)
                if okEnum and enumGroup and enumGroup[raw.name] then
                    Config[k] = enumGroup[raw.name]
                end
            elseif type(raw) == "table" and raw.__type == "Color3" and expectedType == "Color3" then
                Config[k] = Color3.fromRGB(
                    math.clamp(tonumber(raw.r) or 255, 0, 255),
                    math.clamp(tonumber(raw.g) or 60, 0, 255),
                    math.clamp(tonumber(raw.b) or 60, 0, 255)
                )
            elseif typeof(raw) == expectedType then
                Config[k] = raw
            end
        end
    end
    Config.FOV = math.clamp(Config.FOV, Config.FOV_MIN, Config.FOV_MAX)
end

local function saveConfigToWorkspace()
    if not canUseWorkspaceFS() then return false end
    local ok = pcall(function()
        if typeof(makefolder) == "function" then
            local folderExists = (typeof(isfolder) == "function") and isfolder(CONFIG_FOLDER) or false
            if not folderExists then
                makefolder(CONFIG_FOLDER)
            end
        end
        local encoded = HttpService:JSONEncode(serializeConfig())
        writefile(CONFIG_FILE, encoded)
    end)
    return ok
end

local function loadConfigFromWorkspace()
    if not canUseWorkspaceFS() then return false end
    local ok = pcall(function()
        if isfile(CONFIG_FILE) then
            local content = readfile(CONFIG_FILE)
            if type(content) == "string" and #content > 0 then
                local decoded = HttpService:JSONDecode(content)
                applyDeserializedConfig(decoded)
            end
        end
    end)
    return ok
end

