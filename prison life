local function playAnim(obj, info, props)
    if not obj then return nil end
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    return tw
end

local function attachButtonJuice(btn, baseSize, pressScale)
    pressScale = pressScale or 0.92
    local smallSize = UDim2.new(
        baseSize.X.Scale * pressScale,
        baseSize.X.Offset * pressScale,
        baseSize.Y.Scale * pressScale,
        baseSize.Y.Offset * pressScale
    )
    btn.MouseEnter:Connect(function()
        playAnim(btn, TweenInfo.new(0.14, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Rotation = (math.random() > 0.5 and 2.5 or -2.5),
        })
    end)
    btn.MouseLeave:Connect(function()
        playAnim(btn, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Rotation = 0,
            Size = baseSize,
        })
    end)
    btn.MouseButton1Down:Connect(function()
        playAnim(btn, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = smallSize,
        })
    end)
    btn.MouseButton1Up:Connect(function()
        playAnim(btn, TweenInfo.new(0.28, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = baseSize,
            Rotation = 0,
        })
    end)
end

