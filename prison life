-- Hook shoot and castRay
for _, v in ipairs(getgc(true)) do
    if type(v) == "function" and not hookedFunctions[v] then
        local name = debug.info(v, "n")
        if name == "shoot" then
            hookedFunctions[v] = true
            local oldShoot
            oldShoot = hookfunction(v, newcclosure(function(...)
                if Config.Enabled and scriptRunning then
                    local mousePos = UserInputService:GetMouseLocation()
                    isShootingSession = true
                    local initialTarget, initialPart = findClosestPlayerToAim(mousePos)
                    if initialTarget then
                        sessionStickyTarget = initialTarget
                        sessionHadTarget = true
                        lastKnownTargetName = initialTarget.Name

                        healthBarTarget = initialTarget
                        healthBarExpireTime = os.clock() + Config.HealthBarHoldTime

                        if initialPart then
                            lastKnownTargetPos = initialPart.Position
                        elseif initialTarget.Character and initialTarget.Character:FindFirstChild("HumanoidRootPart") then
                            lastKnownTargetPos = initialTarget.Character.HumanoidRootPart.Position
                        end
                    else
                        sessionStickyTarget = nil
                        sessionHadTarget = false
                        lastKnownTargetPos = nil
                        lastKnownTargetName = nil
                    end
                end
                local res = { pcall(oldShoot, ...) }
                resetShootingSessionState()
                if res[1] then
                    return table.unpack(res, 2)
                end
            end))
        elseif name == "castRay" then
            hookedFunctions[v] = true
            local oldCast
            oldCast = hookfunction(v, newcclosure(function(origin, targetPos, spread, ...)
                if isShootingSession and Config.Enabled and scriptRunning then
                    local camera = Workspace.CurrentCamera
                    local aimScreenPos = UserInputService:GetMouseLocation()

                    if sessionHadTarget then
                        if sessionStickyTarget ~= nil and isAliveTargetPlayer(sessionStickyTarget) then
                            healthBarTarget = sessionStickyTarget
                            healthBarExpireTime = os.clock() + Config.HealthBarHoldTime

                            local char = sessionStickyTarget.Character
                            local hrp = char and char:FindFirstChild("HumanoidRootPart")
                            local closestPart = camera and getClosestPartOnCharacter(char, camera, aimScreenPos) or nil

                            if closestPart then
                                lastKnownTargetPos = closestPart.Position
                                local decision = rollShotAim(sessionStickyTarget, closestPart)
                                if decision then
                                    lastKnownTargetPos = decision.pos
                                    local stateLabel = decision.moving and "Moving" or "Stationary"
                                    if decision.isHit then
                                        debugPrint(string.format("[SilentAim] [%s] Hit %s (%s)", stateLabel, decision.targetName, decision.partName))
                                    else
                                        debugPrint(string.format("[SilentAim] [%s] Miss %s (~%.1f studs)", stateLabel, decision.targetName, decision.missDist))
                                    end
                                    return oldCast(origin, decision.pos, 0, ...)
                                end
                            else
                                if hrp then
                                    lastKnownTargetPos = hrp.Position
                                end
                                debugPrint(string.format("[SilentAim] Target %s behind wall — normal aim", sessionStickyTarget.Name))
                                return oldCast(origin, targetPos, spread, ...)
                            end
                        else
                            if lastKnownTargetPos then
                                local deadDecision = rollLastKnownPositionAim(lastKnownTargetPos, lastKnownTargetName)
                                local stateLabel = deadDecision.moving and "Moving" or "Stationary"
                                debugPrint(string.format("[SilentAim] [%s] Target %s died/vanished — shooting last pos", stateLabel, deadDecision.targetName))
                                return oldCast(origin, deadDecision.pos, 0, ...)
                            end
                        end
                    end
                end
                return oldCast(origin, targetPos, spread, ...)
            end))
        end
    end
end

