    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, -24, 0, 12)
    track.Position = UDim2.new(0, 12, 0, 65)
    track.BackgroundColor3 = PALETTE.RoyalBlue
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = card
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = PALETTE.Magenta
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 2)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 18, 0, 18)
    dot.AnchorPoint = Vector2.new(0.5, 0.5)
    dot.Position = UDim2.new(0, 0, 0.5, 0)
    dot.BackgroundColor3 = PALETTE.NeonGreen
    dot.BorderSizePixel = 0
    dot.Parent = track
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 3)

    local dotStroke = Instance.new("UIStroke")
    dotStroke.Color = PALETTE.RoyalBlue
    dotStroke.Thickness = 2
    dotStroke.Parent = dot

    local function getBounds()
        local lo = type(minVal) == "function" and minVal() or minVal
        local hi = type(maxVal) == "function" and maxVal() or maxVal
        if hi <= lo then hi = lo + 1 end
        return lo, hi
    end

    local function updateVisual(animated)
        local lo, hi = getBounds()
        local current = math.clamp(tonumber(Config[key]) or lo, lo, hi)
        local ratio = (current - lo) / (hi - lo)
        if animated then
            playAnim(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(ratio, 0, 1, 0),
            })
            playAnim(dot, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(ratio, 0, 0.5, 0),
            })
        else
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            dot.Position = UDim2.new(ratio, 0, 0.5, 0)
        end
        valBox.Text = string.format(fmt, current, suffix)
    end

    local function applyValue(raw)
        local lo, hi = getBounds()
        local stepped = math.floor((raw / stepVal) + 0.5) * stepVal
        local mult = 10 ^ decimals
        stepped = math.floor(stepped * mult + 0.5) / mult
        Config[key] = math.clamp(stepped, lo, hi)
        updateVisual(true)
        if onChanged then
            onChanged(Config[key])
        end
        refreshStatus()
    end

    local sliding = false
    local function setFromScreenX(x)
        local lo, hi = getBounds()
        local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        applyValue(lo + (hi - lo) * rel)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            playAnim(dot, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 24, 0, 24),
            })
            setFromScreenX(input.Position.X)
        end
    end)

    local endConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if sliding then
                sliding = false
                playAnim(dot, TweenInfo.new(0.22, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 18, 0, 18),
                })
            end
        end
    end)
    table.insert(activeConnections, endConn)

    local moveConn = UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromScreenX(input.Position.X)
        end
    end)
    table.insert(activeConnections, moveConn)

    valBox.FocusLost:Connect(function()
        local numStr = valBox.Text:match("[-%d%.]+")
        local parsed = tonumber(numStr)
        if parsed then
            applyValue(parsed)
        else
            updateVisual(true)
        end
    end)

    table.insert(uiRefreshCallbacks, function() updateVisual(false) end)
    updateVisual(false)
end

