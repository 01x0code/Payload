local function isAliveTargetPlayer(plr)
    if not plr or plr == LocalPlayer or not plr.Parent then
        return false
    end
    if Config.TeamCheck and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team then
        return false
    end
    local char = plr.Character
    if not char then
        return false
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        return false
    end
    if char:FindFirstChildOfClass("ForceField") then
        return false
    end
    return true
end

local function getRandomPointInPart(part, spreadScale)
    local scale = math.clamp(spreadScale or 0.75, 0, 1)
    local halfX = (part.Size.X * 0.5) * scale
    local halfY = (part.Size.Y * 0.5) * scale
    local halfZ = (part.Size.Z * 0.5) * scale

    local localOffset = Vector3.new(
        (math.random() * 2 - 1) * halfX,
        (math.random() * 2 - 1) * halfY,
        (math.random() * 2 - 1) * halfZ
    )

    return part.CFrame:PointToWorldSpace(localOffset)
end

local function isLocalPlayerMoving()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not hrp:IsA("BasePart") then
        return false
    end
    local horizVel = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
    return horizVel.Magnitude > Config.MoveSpeedThreshold
end

local function isPointClear(originPos, targetPos, targetCharacter)
    if not Config.CheckWall then return true end
    local delta = targetPos - originPos
    local dist = delta.Magnitude
    if dist <= 0.01 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
    local junk = Workspace:FindFirstChild("EffectsJunk")
    if junk then table.insert(ignore, junk) end
    params.FilterDescendantsInstances = ignore
    params.IgnoreWater = true

    local res = Workspace:Raycast(originPos, delta.Unit * dist, params)
    if not res then return true end
    if targetCharacter and res.Instance and res.Instance:IsDescendantOf(targetCharacter) then
        return true
    end
    return false
end

local function getClosestPartOnCharacter(character, camera, aimScreenPos)
    local bestPart = nil
    local bestDist = math.huge
    local camPos = camera.CFrame.Position
    local fovRadius = Config.FOV

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
            if isPointClear(camPos, child.Position, character) then
                local sp, onScreen = camera:WorldToViewportPoint(child.Position)
                if onScreen and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - aimScreenPos).Magnitude
                    if d <= fovRadius and d < bestDist then
                        bestDist = d
                        bestPart = child
                    end
                end
            end
        end
    end

    if not bestPart then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:IsA("BasePart") and isPointClear(camPos, hrp.Position, character) then
            local sp, onScreen = camera:WorldToViewportPoint(hrp.Position)
            if onScreen and sp.Z > 0 then
                local d = (Vector2.new(sp.X, sp.Y) - aimScreenPos).Magnitude
                if d <= fovRadius then
                    bestPart = hrp
                    bestDist = d
                end
            end
        end
    end

    return bestPart, bestDist
end

local function findClosestPlayerToAim(aimScreenPos)
    local camera = Workspace.CurrentCamera
    if not camera then return nil, nil end

    local mousePos = aimScreenPos or UserInputService:GetMouseLocation()
    local bestPlr, bestPart, bestDist = nil, nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if isAliveTargetPlayer(plr) then
            local part, dist = getClosestPartOnCharacter(plr.Character, camera, mousePos)
            if part and dist < bestDist then
                bestDist = dist
                bestPlr = plr
                bestPart = part
            end
        end
    end

    return bestPlr, bestPart
end

local function rollShotAim(plr, closestPart)
    local char = plr and plr.Character
    if not char then return nil end

    local moving = isLocalPlayerMoving()
    local hitChance = moving and Config.MovingHitChance or Config.StationaryHitChance
    local rollPercent = math.random() * 100
    local isHit = rollPercent <= hitChance

    if isHit then
        local chosenPart = closestPart or char:FindFirstChild("HumanoidRootPart")
        if not chosenPart then return nil end

        local aimPoint = getRandomPointInPart(chosenPart, Config.PartSpreadScale)

        return {
            isHit = true,
            moving = moving,
            pos = aimPoint,
            targetName = plr.Name,
            partName = chosenPart.Name,
            missDist = 0,
        }
    else
        local parts = {}
        for _, name in ipairs(partPool) do
            local p = char:FindFirstChild(name)
            if p and p:IsA("BasePart") then
                table.insert(parts, p)
            end
        end
        local anchor = (#parts > 0 and parts[math.random(1, #parts)]) or closestPart or char:FindFirstChild("HumanoidRootPart")
        if not anchor then return nil end

        local minD = math.min(Config.MissMinStuds, Config.MissMaxStuds)
        local maxD = math.max(Config.MissMinStuds, Config.MissMaxStuds)
        local missDist = minD + (math.random() * (maxD - minD))

        local dir = Vector3.new(math.random() * 2 - 1, math.random() * 0.4 - 0.2, math.random() * 2 - 1)
        if dir.Magnitude < 0.01 then dir = Vector3.new(1, 0, 0) end

        return {
            isHit = false,
            moving = moving,
            pos = anchor.Position + (dir.Unit * missDist),
            targetName = plr.Name,
            partName = anchor.Name,
            missDist = missDist,
        }
    end
end

local function rollLastKnownPositionAim(lastPos, targetName)
    local moving = isLocalPlayerMoving()
    local hitChance = moving and Config.MovingHitChance or Config.StationaryHitChance
    local isHit = (math.random() * 100) <= hitChance

    if isHit then
        local r = Config.DeadSpotSpread
        local offset = Vector3.new(
            (math.random() * 2 - 1) * r,
            (math.random() * 2 - 1) * r,
            (math.random() * 2 - 1) * r
        )
        return {
            isHit = true,
            moving = moving,
            pos = lastPos + offset,
            targetName = targetName or "Unknown",
            missDist = 0,
        }
    else
        local minD = math.min(Config.MissMinStuds, Config.MissMaxStuds)
        local maxD = math.max(Config.MissMinStuds, Config.MissMaxStuds)
        local missDist = minD + (math.random() * (maxD - minD))

        local dir = Vector3.new(math.random() * 2 - 1, math.random() * 0.4 - 0.2, math.random() * 2 - 1)
        if dir.Magnitude < 0.01 then dir = Vector3.new(1, 0, 0) end

        return {
            isHit = false,
            moving = moving,
            pos = lastPos + (dir.Unit * missDist),
            targetName = targetName or "Unknown",
            missDist = missDist,
        }
    end
end

local function getCharacterScreenBox(character, camera)
    local cf, size = character:GetBoundingBox()
    local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5

    local corners = {
        cf * Vector3.new(-hx,  hy, -hz),
        cf * Vector3.new( hx,  hy, -hz),
        cf * Vector3.new(-hx, -hy, -hz),
        cf * Vector3.new( hx, -hy, -hz),
        cf * Vector3.new(-hx,  hy,  hz),
        cf * Vector3.new( hx,  hy,  hz),
        cf * Vector3.new(-hx, -hy,  hz),
        cf * Vector3.new( hx, -hy,  hz),
    }

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local visibleAny = false

    for _, c in ipairs(corners) do
        local sp = camera:WorldToViewportPoint(c)
        if sp.Z > 0 then
            visibleAny = true
            if sp.X < minX then minX = sp.X end
            if sp.X > maxX then maxX = sp.X end
            if sp.Y < minY then minY = sp.Y end
            if sp.Y > maxY then maxY = sp.Y end
        end
    end

    if not visibleAny or maxX <= minX or maxY <= minY then
        return nil
    end
    return Vector2.new(minX, minY), Vector2.new(maxX, minY), Vector2.new(minX, maxY), Vector2.new(maxX, maxY)
end

local function getHealthBarColor(ratio)
    local r = math.clamp(ratio, 0, 1)
    if r > 0.5 then
        local t = (1 - r) * 2
        return Color3.fromRGB(math.floor(60 + 195 * t), 235, math.floor(100 * (1 - t)))
    else
        local t = r * 2
        return Color3.fromRGB(255, math.floor(60 + 175 * t), 60)
    end
end

local function updateCursorHealthBar(mousePos)
    if not Config.Enabled or not Config.ShowCursorHealthBar then
        setHealthBarVisible(false)
        return
    end

    if isShootingSession and sessionStickyTarget ~= nil and sessionStickyTarget.Parent then
        healthBarTarget = sessionStickyTarget
        healthBarExpireTime = os.clock() + Config.HealthBarHoldTime
    end

    if not healthBarTarget or not healthBarTarget.Parent or os.clock() > healthBarExpireTime then
        healthBarTarget = nil
        setHealthBarVisible(false)
        return
    end

    local char = healthBarTarget.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        healthBarTarget = nil
        setHealthBarVisible(false)
        return
    end

    local maxHp = (hum.MaxHealth and hum.MaxHealth > 0) and hum.MaxHealth or 100
    local curHp = math.clamp(hum.Health, 0, maxHp)
    local ratio = curHp / maxHp

    local w = Config.HealthBarWidth
    local h = Config.HealthBarHeight
    local barX = mousePos.X - (w * 0.5)
    local barY = mousePos.Y + Config.HealthBarOffsetY

    hpBg.Position = Vector2.new(barX - 1, barY - 1)
    hpBg.Size = Vector2.new(w + 2, h + 2)

    hpFill.Position = Vector2.new(barX, barY)
    hpFill.Size = Vector2.new(math.max(0, w * ratio), h)
    hpFill.Color = getHealthBarColor(ratio)

    hpOutline.Position = Vector2.new(barX - 1, barY - 1)
    hpOutline.Size = Vector2.new(w + 2, h + 2)

    hpLabel.Position = Vector2.new(mousePos.X, barY + h + 2)
    hpLabel.Text = string.format("%s | %d / %d HP", healthBarTarget.Name, math.ceil(curHp), math.ceil(maxHp))

    setHealthBarVisible(true)

    if curHp <= 0 and healthBarExpireTime > os.clock() + 0.6 then
        healthBarExpireTime = os.clock() + 0.6
    end
end

local renderConn = RunService.RenderStepped:Connect(function()
    if not scriptRunning then return end

