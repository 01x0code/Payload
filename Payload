-- ==========================================
-- CONFIGURATION & SETTINGS
-- ==========================================
local CONFIG = {
    debugMode = false, -- ตั้งค่าเป็น true เพื่อแสดง Log หรือ false เพื่อปิด Log ทั้งหมด
}

-- ฟังก์ชันช่วยจัดการ Log ตามสถานะ Debug Mode
local function debugPrint(...)
    if CONFIG.debugMode then
        print("[PayloadSystem]", ...)
    end
end

-- ==========================================
-- PAYLOAD CONFIGURATIONS BY MAP ID
-- ==========================================
local currentPlaceId = game.PlaceId

-- กำหนดตารางจับคู่ Map ID กับฟังก์ชัน Payload
local mapPayloads = {
    [13687899540] = function()
        debugPrint("กำลังรัน Payload สำหรับ Coldwar")
        loadstring(game:HttpGet("https://raw.githubusercontent.com/01x0code/Coldwarscript/refs/heads/main/Coldwar"))()
    end,

    [14419907512] = function() -- เปลี่ยนเป็น PlaceId จริงของ Map B
        debugPrint("กำลังรัน Payload สำหรับ Zombie game [upd3]")
        loadstring(game:HttpGet("https://raw.githubusercontent.com/01x0code/Zombie-game/refs/heads/main/Eng%20version%20%E0%B8%94%E0%B8%B1%E0%B8%94%E0%B9%81%E0%B8%9B%E0%B8%A5%E0%B8%87%20script%20%E0%B8%97%E0%B8%B5%E0%B9%88%E0%B8%99%E0%B8%B5%E0%B9%88"))()
    end,
}

-- ==========================================
-- CORE FUNCTION
-- ==========================================
local function executePayload()
    local payloadFunction = mapPayloads[currentPlaceId]
    
    if payloadFunction then
        debugPrint("พบ Map ID ที่ตรงกัน:", currentPlaceId, "กำลังรัน Payload...")
        payloadFunction()
    else
        -- ถ้าไม่ตรงกับแมพไหนเลย ให้รันผ่านไปเงียบๆ (หรือโชว์ Log เฉพาะตอนเปิด debugMode)
        debugPrint("ไม่พบ Map ID (" .. currentPlaceId .. ") ในระบบ ข้ามการทำงานไป...")
    end
end

-- เริ่มต้นรันระบบ
executePayload()
